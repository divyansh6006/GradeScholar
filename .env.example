# Copy this file to .env (local dev) or set these in Hostinger's env var
# panel (production). Never commit the real .env file.

# --- Local development ---
# A plain local file is fine for dev — fast, no account needed.
DATABASE_URL="file:./dev.db"

# --- Production (Hostinger) ---
# Use a hosted Turso database instead, so the database survives redeploys
# (Hostinger's git-based deploys rebuild the app directory from scratch —
# a local file would be wiped every time you push).
#   1. Create a free database at https://turso.tech
#   2. Get its URL and an auth token from the Turso dashboard/CLI
#   3. Set DATABASE_URL to the full connection string WITH the token
#      embedded as a query param — this single value works for both the
#      Prisma CLI (migrate deploy) and the app at runtime:
#
#   DATABASE_URL="libsql://your-db-name-yourorg.turso.io?authToken=xxxxx"
#
# (DATABASE_AUTH_TOKEN below is an alternative if you'd rather keep the
# token out of the URL string — set it instead of embedding ?authToken=.)
DATABASE_AUTH_TOKEN=""

# Signs admin session cookies. Generate a new random value for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this instantly logs out every admin session.
ADMIN_SESSION_SECRET=""

# Used ONLY by `npm run db:seed` to create the first admin account.
# Set these to real production credentials before seeding, then change
# the password again from within the admin panel if you add that flow later.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Required by Next.js in production
NODE_ENV="production"

# Port the app listens on (server.js reads this; Hostinger sets it for you)
PORT="3000"
